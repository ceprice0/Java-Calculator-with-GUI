pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        string(
            name: 'CONTROL_HOST',
            defaultValue: '',
            description: 'Current public IPv4 address or DNS name of webserver2'
        )
        string(
            name: 'WEBSERVER3_PRIVATE_IP',
            defaultValue: '',
            description: 'Current private IPv4 address of webserver3'
        )
        string(
            name: 'WEBSERVER4_PRIVATE_IP',
            defaultValue: '',
            description: 'Current private IPv4 address of webserver4'
        )
        string(
            name: 'SSH_CREDENTIAL_ID',
            defaultValue: 'ec2-ssh-key',
            description: 'Jenkins SSH Username with private key credential ID'
        )
    }

    environment {
        IMAGE_REPO = 'calum1/java-calculator-with-gui'
        IMAGE_TAG = 'latest'
        EC2_USER = 'ec2-user'
        CONTAINER_NAME = 'java-calculator-with-gui'
        REMOTE_ANSIBLE_DIR = '/home/ec2-user/java-calculator-with-gui/ansible'
    }

    stages {
        stage('Validate parameters') {
            steps {
                script {
                    def controlHost = params.CONTROL_HOST?.trim()
                    if (!controlHost || !(controlHost ==~ /[A-Za-z0-9][A-Za-z0-9.-]*/)) {
                        error('Set CONTROL_HOST to the current public IPv4 address or DNS name of webserver2.')
                    }

                    def isPrivateIpv4 = { String address ->
                        def octets = address.split(/\./, -1)
                        if (octets.length != 4 || octets.any { !(it ==~ /\d{1,3}/) }) {
                            return false
                        }
                        def values = octets.collect { it.toInteger() }
                        if (values.any { it < 0 || it > 255 }) {
                            return false
                        }
                        return values[0] == 10 ||
                            (values[0] == 172 && values[1] >= 16 && values[1] <= 31) ||
                            (values[0] == 192 && values[1] == 168)
                    }

                    if (!isPrivateIpv4(params.WEBSERVER3_PRIVATE_IP?.trim() ?: '')) {
                        error('WEBSERVER3_PRIVATE_IP must be a private IPv4 address.')
                    }
                    if (!isPrivateIpv4(params.WEBSERVER4_PRIVATE_IP?.trim() ?: '')) {
                        error('WEBSERVER4_PRIVATE_IP must be a private IPv4 address.')
                    }
                    if (params.WEBSERVER3_PRIVATE_IP.trim() == params.WEBSERVER4_PRIVATE_IP.trim()) {
                        error('webserver3 and webserver4 must have different private IP addresses.')
                    }
                    if (!params.SSH_CREDENTIAL_ID?.trim()) {
                        error('Set SSH_CREDENTIAL_ID to the Jenkins SSH credential ID.')
                    }
                }
            }
        }

        stage('Checkout Ansible files') {
            steps {
                dir('ci-source') {
                    checkout scm
                }
            }
        }

        stage('Install Ansible on webserver2') {
            steps {
                sshagent(credentials: [params.SSH_CREDENTIAL_ID.trim()]) {
                    sh '''
                        set -eu

                        ssh -A -o BatchMode=yes "$EC2_USER@$CONTROL_HOST" 'bash -se' <<'REMOTE'
                        set -eu

                        if [ ! -x "$HOME/ansible-venv/bin/ansible-playbook" ]; then
                            sudo dnf install -y python3 python3-pip
                            python3 -m venv "$HOME/ansible-venv"
                            "$HOME/ansible-venv/bin/pip" install --upgrade pip ansible-core
                        fi

                        "$HOME/ansible-venv/bin/ansible-playbook" --version
REMOTE
                    '''
                }
            }
        }

        stage('Generate inventory and copy Ansible files') {
            steps {
                script {
                    writeFile(
                        file: 'ci-source/ansible/inventory.ini',
                        text: """[webservers]
webserver3 ansible_host=${params.WEBSERVER3_PRIVATE_IP.trim()} ansible_user=ec2-user
webserver4 ansible_host=${params.WEBSERVER4_PRIVATE_IP.trim()} ansible_user=ec2-user
"""
                    )
                }
                sshagent(credentials: [params.SSH_CREDENTIAL_ID.trim()]) {
                    sh '''
                        set -eu

                        ssh -o BatchMode=yes "$EC2_USER@$CONTROL_HOST" \
                            "mkdir -p '$REMOTE_ANSIBLE_DIR'"

                        scp -o BatchMode=yes \
                            ci-source/ansible/inventory.ini \
                            ci-source/ansible/deploy.yml \
                            "$EC2_USER@$CONTROL_HOST:$REMOTE_ANSIBLE_DIR/"
                    '''
                }
            }
        }

        stage('Deploy to webserver3 and webserver4') {
            steps {
                sshagent(credentials: [params.SSH_CREDENTIAL_ID.trim()]) {
                    sh '''
                        set -eu

                        ssh -A -o BatchMode=yes "$EC2_USER@$CONTROL_HOST" \
                            "IMAGE_REPO='$IMAGE_REPO' IMAGE_TAG='$IMAGE_TAG' bash -se" <<'REMOTE'
                        set -eu

                        test -n "$SSH_AUTH_SOCK"
                        cd "$HOME/java-calculator-with-gui/ansible"

                        "$HOME/ansible-venv/bin/ansible-playbook" \
                            -i inventory.ini deploy.yml \
                            -e "image_repo=$IMAGE_REPO" \
                            -e "image_tag=$IMAGE_TAG"
REMOTE
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Ansible deployment to webserver3 and webserver4 completed successfully.'
        }
        failure {
            echo 'Ansible deployment failed. Check the Jenkins Console Output.'
        }
    }
}
